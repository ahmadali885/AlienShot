<?xml version="1.0" encoding="utf-8"?>
<!-- The macOS counterpart of installer/alienshot.iss: a step-by-step
     Installer.app wizard that puts AlienShot.app into /Applications.
     @VERSION@ is filled in from pubspec.yaml by the macOS workflow. -->
<installer-gui-script minSpecVersion="2">
    <title>AlienShot</title>
    <organization>com.alienwavegroup</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <background file="background.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>
    <background-darkAqua file="background-dark.tiff" mime-type="image/tiff" alignment="bottomleft" scaling="none"/>

    <!-- The app is universal; listing both stops Apple Silicon Macs from
         offering to install Rosetta for the installer. -->
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="10.15"/>
    </allowed-os-versions>

    <choices-outline>
        <line choice="default">
            <line choice="com.alienwavegroup.alienshot"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.alienwavegroup.alienshot" visible="false">
        <pkg-ref id="com.alienwavegroup.alienshot"/>
    </choice>
    <pkg-ref id="com.alienwavegroup.alienshot" version="@VERSION@" onConclusion="none">AlienShot-component.pkg</pkg-ref>
</installer-gui-script>
