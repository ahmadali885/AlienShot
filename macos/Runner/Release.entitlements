<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox is off on purpose: screen capture on macOS runs the system's
	     /usr/sbin/screencapture binary, which a sandboxed app is not allowed to
	     spawn. Snaply is distributed directly, not through the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
